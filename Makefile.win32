# Windows binaries.
#   make -f Makefile.win32                 MinGW-w64 (default)
#   make -f Makefile.win32 TOOLSET=msvc    Visual Studio cl (vcvars64)

TOOLSET ?= mingw

TAG ?=
NAMES = xcb-tile xcb-tile-anim xcb-tile-sprites xcb-tile-mask xcb-tile-play
DEMOS = $(addsuffix $(TAG).exe,$(NAMES))

.DEFAULT_GOAL := all
.PHONY: all clean check-mingw check-msvc

ifeq ($(TOOLSET),msvc)

ifeq ($(OS),Windows_NT)
CL = msvc-cl.cmd
DEVNUL = NUL
else
CL = sh msvc-cl.sh
DEVNUL = /dev/null
endif

WINLIBS = user32.lib gdi32.lib winmm.lib
CLFLAGS = -nologo -O2 -W3 -D_CRT_SECURE_NO_WARNINGS
MSVC_GUI = -link -SUBSYSTEM:WINDOWS -ENTRY:mainCRTStartup

all: check-msvc $(DEMOS)
	@echo "win32 TOOLSET=msvc  (cl)"

check-msvc:
	@$(CL) -nologo -Bv >$(DEVNUL) 2>&1 || { \
	  echo "Need Visual Studio C++ x64 toolset (cl + vcvars64)."; \
	  echo "  make -f Makefile.win32 TOOLSET=msvc"; \
	  echo "  Or set VCVARS to your vcvars64.bat"; \
	  exit 1; }

xcb-tile$(TAG).exe: demo.c hw.c plat_win32.c map.c hw.h hw_internal.h map.h
	$(CL) $(CLFLAGS) -Fe$@ demo.c hw.c plat_win32.c map.c $(MSVC_GUI) $(WINLIBS)

xcb-tile-anim$(TAG).exe: demo_anim.c hw.c plat_win32.c map.c hw.h hw_internal.h map.h
	$(CL) $(CLFLAGS) -Fe$@ demo_anim.c hw.c plat_win32.c map.c $(MSVC_GUI) $(WINLIBS)

xcb-tile-sprites$(TAG).exe: demo_sprites.c hw.c plat_win32.c map.c hw.h hw_internal.h map.h
	$(CL) $(CLFLAGS) -Fe$@ demo_sprites.c hw.c plat_win32.c map.c $(MSVC_GUI) $(WINLIBS)

xcb-tile-mask$(TAG).exe: demo_mask.c hw.c plat_win32.c map.c hw.h hw_internal.h map.h
	$(CL) $(CLFLAGS) -Fe$@ demo_mask.c hw.c plat_win32.c map.c $(MSVC_GUI) $(WINLIBS)

xcb-tile-play$(TAG).exe: demo_play.c play.c bank.c bank_hw.c hw.c plat_win32.c play.h bank.h hw.h
	$(CL) $(CLFLAGS) -Fe$@ demo_play.c play.c bank.c bank_hw.c hw.c plat_win32.c $(MSVC_GUI) $(WINLIBS)

else

ifeq ($(OS),Windows_NT)
MINGW_CC ?= gcc
else
MINGW_CC ?= x86_64-w64-mingw32-gcc
endif
MINGW_GUI = -mwindows -lgdi32 -luser32 -lwinmm

all: check-mingw $(DEMOS)
	@echo "win32 TOOLSET=mingw  ($(MINGW_CC))"

check-mingw:
	@command -v $(MINGW_CC) >/dev/null || { \
	  echo "Need MinGW-w64. On Debian/Ubuntu/WSL:"; \
	  echo "  sudo apt install gcc-mingw-w64-x86-64"; \
	  echo "Then re-run: make -f Makefile.win32"; \
	  echo "Or: make -f Makefile.win32 TOOLSET=msvc"; \
	  exit 1; }

xcb-tile$(TAG).exe: demo.c hw.c plat_win32.c map.c hw.h hw_internal.h map.h
	$(MINGW_CC) -std=c11 -Wall -Wextra -O2 -o $@ demo.c hw.c plat_win32.c map.c \
		$(MINGW_GUI)

xcb-tile-anim$(TAG).exe: demo_anim.c hw.c plat_win32.c map.c hw.h hw_internal.h map.h
	$(MINGW_CC) -std=c11 -Wall -Wextra -O2 -o $@ demo_anim.c hw.c plat_win32.c map.c \
		$(MINGW_GUI)

xcb-tile-sprites$(TAG).exe: demo_sprites.c hw.c plat_win32.c map.c hw.h hw_internal.h map.h
	$(MINGW_CC) -std=c11 -Wall -Wextra -O2 -o $@ demo_sprites.c hw.c plat_win32.c map.c \
		$(MINGW_GUI)

xcb-tile-mask$(TAG).exe: demo_mask.c hw.c plat_win32.c map.c hw.h hw_internal.h map.h
	$(MINGW_CC) -std=c11 -Wall -Wextra -O2 -o $@ demo_mask.c hw.c plat_win32.c map.c \
		$(MINGW_GUI)

xcb-tile-play$(TAG).exe: demo_play.c play.c bank.c bank_hw.c hw.c plat_win32.c play.h bank.h hw.h
	$(MINGW_CC) -std=c11 -Wall -Wextra -O2 -o $@ demo_play.c play.c bank.c bank_hw.c hw.c plat_win32.c \
		$(MINGW_GUI)

endif

clean:
	rm -f $(DEMOS) *.obj \
		$(addsuffix .exe,$(NAMES)) \
		$(addsuffix -mingw.exe,$(NAMES)) \
		$(addsuffix -w64.exe,$(NAMES)) \
		$(addsuffix -msvc.exe,$(NAMES))
